{
  "manifest_version": 3,
  "name": "Prepify Capture",
  "version": "0.3.0",
  "description": "Pulls interview questions, answers and reviews from the pages you ask for into your Prepify tab. Nothing is stored on a server.",
  "permissions": ["contextMenus", "storage"],
  "host_permissions": [
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "*://*.glassdoor.com/*",
        "*://*.glassdoor.co.in/*",
        "*://*.ambitionbox.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:5000/*",
        "http://127.0.0.1:5000/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
