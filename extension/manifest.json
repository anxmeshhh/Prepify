{
  "manifest_version": 3,
  "name": "Prepify Capture",
  "version": "0.1.0",
  "description": "Save interview questions and reviews from the pages you are viewing into your local Prepify app.",
  "permissions": ["contextMenus"],
  "host_permissions": [
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "*://*.glassdoor.com/*",
        "*://*.glassdoor.co.in/*",
        "*://*.ambitionbox.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
