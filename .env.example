# Copy to .env and fill in. .env is git-ignored.
# Optional: your own OAuth 2.0 Client ID (Web application) from Google Cloud Console; overrides the built-in one.
GOOGLE_CLIENT_ID=
# Any long random string; keeps sign-ins valid across restarts.
PREPIFY_SECRET=
# Optional: Reddit official API (installed app client ID from https://www.reddit.com/prefs/apps).
REDDIT_CLIENT_ID=
# Optional: AI assist on Groq. An API key from https://console.groq.com/keys. Leave empty to run without AI.
GROQ_API_KEY=
# Optional AI settings: the model doing the work (default openai/gpt-oss-120b), the Prompt Guard model that
# screens text first (empty turns screening off), and AI requests per signed-in user per day.
PREPIFY_AI_MODEL=
# Faster model used for tidying pulled questions (default openai/gpt-oss-20b).
PREPIFY_AI_FAST_MODEL=
PREPIFY_AI_GUARD_MODEL=meta-llama/llama-prompt-guard-2-22m
PREPIFY_AI_DAILY_LIMIT=60
# Development: 1 runs Flask's auto-reloading dev server instead of waitress.
PREPIFY_DEBUG=
# Question tidying has its own pool (gpt-oss-20b has its own 200K a day at Groq).
PREPIFY_AI_FAST_DAILY_TOKENS=160000
PREPIFY_AI_FAST_USER_DAILY_TOKENS=80000
