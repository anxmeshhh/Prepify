# Copy to .env and fill in. .env is git-ignored.
# OAuth 2.0 Client ID (Web application) from Google Cloud Console; no client secret needed.
GOOGLE_CLIENT_ID=
# Any long random string; keeps sign-ins valid across restarts.
PREPIFY_SECRET=
# Optional: Reddit official API (installed app client ID from https://www.reddit.com/prefs/apps).
REDDIT_CLIENT_ID=
# Optional: AI assist (Claude). An API key from https://platform.claude.com. Leave empty to run without AI.
ANTHROPIC_API_KEY=
# Optional AI settings: the model (default claude-opus-5-5), the model tried if it declines a request,
# and AI requests per signed-in user per day.
PREPIFY_AI_MODEL=
PREPIFY_AI_FALLBACK_MODEL=claude-opus-5
PREPIFY_AI_DAILY_LIMIT=60
